# Copie este archivo como .env y ponga valores propios. El backend NO arranca con
# los valores de ejemplo de JWT_SECRET ni de HCE_ADMIN_PASSWORD.

# ---- Base de datos ----
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=hce_medicina_general
# Usuario con el que se conecta la API (no usa root).
MYSQL_USER=hcemg_app
MYSQL_PASSWORD=cambia_esta_clave_app

# ---- API ----
# Mínimo 32 caracteres aleatorios. Ejemplo: openssl rand -base64 48
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_32_o_mas
# Administrador inicial: se crea al primer arranque. Después la clave se cambia en la app.
HCE_ADMIN_USERNAME=admin
HCE_ADMIN_PASSWORD=cambia_esta_clave_inicial
# Direcciones desde las que se abre la app, separadas por coma.
ALLOWED_ORIGINS=http://localhost:8520

# ---- Puertos ----
FRONTEND_PORT=8520
MYSQL_PORT=33520

# ---- HTTPS opcional (docker compose --profile https up -d) ----
# Nombre o IP con que los equipos abren la app; añada https://<HTTPS_HOST>:<HTTPS_PORT> a ALLOWED_ORIGINS.
HTTPS_HOST=localhost
HTTPS_PORT=8543

# ---- Respaldos ----
BACKUP_RETENTION_DAYS=30
